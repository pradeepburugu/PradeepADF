{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "manaswini-dev-adf"
		},
		"ls_get_job_definition_id_functionKey": {
			"type": "secureString",
			"metadata": "Secure string for 'functionKey' of 'ls_get_job_definition_id'"
		},
		"AzureDataLakeStorage1_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://manaswinistoragedev.dfs.core.windows.net/"
		},
		"ls_get_job_definition_id_properties_typeProperties_functionAppUrl": {
			"type": "string",
			"defaultValue": "https://jobdefention.azurewebsites.net"
		},
		"ls_get_new_file_downloaded_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "@{linkedService().url}"
		},
		"ls_manaswini_dev_kv_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://manaswini-dev-kv.vault.azure.net/"
		},
		"ls_pradeep_local_file_system_properties_typeProperties_host": {
			"type": "string",
			"defaultValue": "D:\\"
		},
		"ls_pradeep_local_file_system_properties_typeProperties_userId": {
			"type": "string",
			"defaultValue": "SVCS"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "manaswini-dev-adf_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"ls_get_job_definition_id_functionKey": {
						"value": "[parameters('ls_get_job_definition_id_functionKey')]"
					},
					"ls_get_job_definition_id_properties_typeProperties_functionAppUrl": {
						"value": "[parameters('ls_get_job_definition_id_properties_typeProperties_functionAppUrl')]"
					},
					"ls_get_new_file_downloaded_properties_typeProperties_url": {
						"value": "[parameters('ls_get_new_file_downloaded_properties_typeProperties_url')]"
					},
					"ls_manaswini_dev_kv_properties_typeProperties_baseUrl": {
						"value": "[parameters('ls_manaswini_dev_kv_properties_typeProperties_baseUrl')]"
					},
					"AzureDataLakeStorage1_properties_typeProperties_url": {
						"value": "[parameters('AzureDataLakeStorage1_properties_typeProperties_url')]"
					},
					"ls_pradeep_local_file_system_properties_typeProperties_host": {
						"value": "[parameters('ls_pradeep_local_file_system_properties_typeProperties_host')]"
					},
					"ls_pradeep_local_file_system_properties_typeProperties_userId": {
						"value": "[parameters('ls_pradeep_local_file_system_properties_typeProperties_userId')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}