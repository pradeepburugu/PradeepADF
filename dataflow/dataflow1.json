{
	"name": "dataflow1",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"linkedService": {
						"referenceName": "AzureDataLakeStorage1",
						"type": "LinkedServiceReference"
					},
					"name": "XML"
				}
			],
			"sinks": [],
			"transformations": [
				{
					"name": "parse1"
				},
				{
					"name": "flatten1"
				},
				{
					"name": "derivedColumn1"
				},
				{
					"name": "derivedColumn2"
				}
			],
			"scriptLines": [
				"source(output(",
				"          {_corrupt_record} as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'xml',",
				"     fileSystem: 'concur',",
				"     folderPath: 'dentsply/xmlfiles',",
				"     fileName: 'test1.txt',",
				"     validationMode: 'none',",
				"     namespaces: true,",
				"     namespacePrefixes: ['http://www.concursolutions.com/api/expense/extract/2010/02'->'ns']) ~> XML",
				"flatten1 parse(id = ERROR_FUNCTION(''),",
				"     format: 'xml',",
				"     namespaces: true,",
				"     namespacePrefixes: ['http://www.concursolutions.com/api/expense/extract/2010/02'->'ns']) ~> parse1",
				"derivedColumn2 foldDown(unroll(),",
				"     mapColumn(",
				"          {_corrupt_record}",
				"     ),",
				"     skipDuplicateMapInputs: false,",
				"     skipDuplicateMapOutputs: false) ~> flatten1",
				"XML derive({_corrupt_record} = replace({_corrupt_record}, '\\\\', '')) ~> derivedColumn1",
				"derivedColumn1 derive({_corrupt_record} = substring({_corrupt_record}, 1, length({_corrupt_record})-1)) ~> derivedColumn2"
			]
		}
	}
}