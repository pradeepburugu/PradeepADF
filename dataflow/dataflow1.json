{
	"name": "dataflow1",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"linkedService": {
						"referenceName": "AzureDataLakeStorage1",
						"type": "LinkedServiceReference"
					},
					"name": "XML"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DelimitedText1",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "parse1"
				},
				{
					"name": "flatten1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          {ns:jobs} as ({ns:job} as ({ns:file-link} as string, {ns:id} as string, {ns:start-time} as string, {ns:status} as string, {ns:status-link} as string, {ns:stop-time} as string)[])",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'xml',",
				"     fileSystem: 'concur',",
				"     folderPath: 'dentsply/xmlfiles',",
				"     fileName: 'test2.txt',",
				"     validationMode: 'none',",
				"     namespaces: true,",
				"     namespacePrefixes: ['http://www.concursolutions.com/api/expense/extract/2010/02'->'ns']) ~> XML",
				"flatten1 parse(format: 'xml',",
				"     namespaces: true) ~> parse1",
				"XML foldDown(unroll({ns:jobs}.{ns:job}),",
				"     mapColumn(",
				"          {ns:file-link} = {ns:jobs}.{ns:job}.{ns:file-link},",
				"          {ns:id} = {ns:jobs}.{ns:job}.{ns:id},",
				"          {ns:start-time} = {ns:jobs}.{ns:job}.{ns:start-time},",
				"          {ns:status} = {ns:jobs}.{ns:job}.{ns:status},",
				"          {ns:status-link} = {ns:jobs}.{ns:job}.{ns:status-link},",
				"          {ns:stop-time} = {ns:jobs}.{ns:job}.{ns:stop-time}",
				"     ),",
				"     skipDuplicateMapInputs: false,",
				"     skipDuplicateMapOutputs: false) ~> flatten1",
				"parse1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> sink1"
			]
		}
	}
}