{
	"name": "df_xml_parser",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DelimitedText1",
						"type": "DatasetReference"
					},
					"name": "dummy"
				}
			],
			"sinks": [
				{
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "flatten1"
				}
			],
			"scriptLines": [
				"parameters{",
				"     sourcexml as string",
				"}",
				"source(output(",
				"          HCPCS as string,",
				"          {Meal Type} as string,",
				"          {Care Program} as string,",
				"          {PayerUnit Price} as string,",
				"          Provider as string,",
				"          Vendor as string,",
				"          {Vendor Unit Price} as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> dummy",
				"dummy derive(xml = $sourcexml) ~> derivedColumn1",
				"derivedColumn1 foldDown(unroll(),",
				"     mapColumn(",
				"          HCPCS,",
				"          {Meal Type},",
				"          {Care Program},",
				"          {PayerUnit Price},",
				"          Provider,",
				"          Vendor,",
				"          {Vendor Unit Price},",
				"          xml",
				"     ),",
				"     skipDuplicateMapInputs: false,",
				"     skipDuplicateMapOutputs: false) ~> flatten1",
				"flatten1 sink(validateSchema: false,",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     store: 'cache',",
				"     format: 'inline',",
				"     output: false,",
				"     saveOrder: 1) ~> sink1"
			]
		}
	}
}