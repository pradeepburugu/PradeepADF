{
	"name": "df_xml_parser",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DelimitedText1",
						"type": "DatasetReference"
					},
					"name": "dummy"
				}
			],
			"sinks": [],
			"transformations": [
				{
					"name": "derivedColumn1"
				}
			],
			"scriptLines": [
				"parameters{",
				"     sourcexml as string",
				"}",
				"source(output(",
				"          HCPCS as string,",
				"          {Meal Type} as string,",
				"          {Care Program} as string,",
				"          {PayerUnit Price} as string,",
				"          Provider as string,",
				"          Vendor as string,",
				"          {Vendor Unit Price} as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> dummy",
				"dummy derive(xml = $sourcexml) ~> derivedColumn1"
			]
		}
	}
}